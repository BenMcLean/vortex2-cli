root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# YAML forbids tab indentation
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing spaces are significant in Markdown (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs for recipes
[{Makefile,*.mk}]
indent_style = tab
